# Config for the `rip` pipeline (workstation, not the docker host).
# Copy to ~/.config/rip/config and edit. No secrets here (IP + paths only).

# --- Upload target (the Jellyfin media server) ---
SERVER="youruser@your-media-server"   # e.g. user@host or user@10.0.0.x on your LAN
MOVIES_DIR="/mnt/media/Movies"   # server path Jellyfin scans for movies
TV_DIR="/mnt/media/TV"           # server path Jellyfin scans for TV

# --- Local ---
DRIVE=0                          # MakeMKV drive index (see: rip --drives)
STAGE="/mnt/data/rips"           # scratch space for raw rips + encodes

# --- Encode (NVENC HEVC on the RTX 3070) ---
ENCODER="nvenc_h265"             # 8-bit HEVC; direct-plays widely, QSV-transcodes cheaply if needed
PRESET="slow"                    # NVENC 'slow' = best quality this encoder offers, still fast
QUALITY=22                       # CQ: lower = bigger/better. 20 archival, 22 great, 24 smaller

# --- Title selection (seconds) ---
MOVIE_MIN=3600                   # ignore titles under 60 min when picking the main feature
TV_MIN=1200                      # keep TV titles >= 20 min ...
TV_MAX=4800                      # ... and <= 80 min (skips the "play all" mega-title & trailers)
